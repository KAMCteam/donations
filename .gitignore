#-------------------------
# Composer
#-------------------------
# Everything composer writes, except the one guard that stops a web server
# listing the folder. `vendor/*` rather than `vendor/` so git still looks
# inside it for that one file.
vendor/*
!vendor/index.html

#-------------------------
# Environment / secrets
#-------------------------
.env

#-------------------------
# Runtime files
#-------------------------
writable/cache/*
!writable/cache/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/temp/*
!writable/temp/index.html
writable/uploads/*
!writable/uploads/index.html

#-------------------------
# Test / build output
#-------------------------
build/*
!build/index.html
phpunit*.xml
!phpunit.dist.xml
.phpunit.*.cache
.php-cs-fixer.php
.php-cs-fixer.cache

#-------------------------
# Editors / OS
#-------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
